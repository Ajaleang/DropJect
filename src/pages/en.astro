---
import ComingSoonLanding from '../components/ComingSoonLanding.astro';

const siteUrl = 'https://dropject.com';
const canonicalUrl = `${siteUrl}/en`;
const title = 'DropJect | Premium Screen Printing in Bogotá';
const description = 'Premium screen printing and end-to-end textile production in Bogotá, Colombia. Get a quote for your next project with DropJect.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#F5F3EF" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={siteUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={siteUrl} />
    <link rel="icon" type="image/png" href="/logos/05.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/logos/04.png`} />
    <meta property="og:locale" content="en_US" />
  </head>
  <body><ComingSoonLanding locale="en" /></body>
</html>
