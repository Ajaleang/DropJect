---
import Layout from '../layouts/Layout.astro';

const seo = {
	title: 'Preguntas Frecuentes | DropJect - Serigrafía y Paquete Completo',
	description: 'Resolvemos tus dudas sobre nuestros servicios de serigrafía, paquete completo, tiempos de producción y materiales. Conoce todo sobre DropJect.',
	keywords: 'preguntas frecuentes, FAQ, serigrafía, paquete completo, producción textil, DropJect',
	canonicalURL: '/preguntas',
	type: 'website'
};

const faqs = [
  {
    q: '¿Qué diferencia hay entre el servicio de estampado y el paquete completo?',
    a: 'El servicio de Estampado en Serigrafía está orientado a clientes que ya tienen sus prendas o producción resuelta y necesitan estampar sus diseños con la más alta calidad: separación de artes, múltiples técnicas de impresión y fotografía de resultados. El Paquete Completo (Full-Pack) cubre todo el ciclo: desde el patronaje y las fichas técnicas, pasando por la selección de telas, muestras, producción completa y entrega final en packaging organizado. Es la solución integral para marcas que quieren delegar todo el proceso.'
  },
  {
    q: '¿Puedo solicitar solo una parte del paquete completo?',
    a: 'Sí. Aunque el Paquete Completo está diseñado como un servicio integral, entendemos que cada marca tiene necesidades distintas. Puedes escribirnos a través del formulario de contacto indicando qué etapas del proceso necesitas (por ejemplo, solo patronaje y muestras, o solo confección y entrega) y construimos una propuesta a tu medida.'
  },
  {
    q: '¿Cuánto tiempo tarda la producción de una colección?',
    a: 'Los tiempos varían según el volumen y la complejidad del proyecto. Para el servicio de estampado, las entregas suelen estar entre 7 y 15 días hábiles dependiendo de la cantidad de prendas y colores. Para el paquete completo, el proceso desde el patronaje hasta la entrega final oscila entre 4 y 8 semanas. En todos los casos coordinamos fechas concretas al inicio del proyecto para que puedas planificar tus lanzamientos con anticipación.'
  },
  {
    q: '¿Qué tipos de telas trabajan?',
    a: 'Trabajamos con la mayoría de las telas utilizadas en moda y streetwear: algodón 100%, mezclas algodón-poliéster, fleece, French terry, telas técnicas y más. La selección del tejido adecuado es clave para garantizar la durabilidad y el resultado visual del estampado, por lo que en el Paquete Completo incluimos una reunión de asesoría para elegir la tela correcta según tu diseño, el uso de la prenda y el presupuesto.'
  }
];
---

<Layout seo={seo}>
  <section class="page-hero">
    <p class="page-hero-label">Preguntas Frecuentes</p>
    <h1 class="page-hero-h1">Todo lo que<br/>necesitas saber.</h1>
    <p class="page-hero-desc">Todo lo que necesitas saber antes de empezar tu producción con DropJect.</p>
  </section>

  <section class="py-24 bg-brand-black text-brand-white min-h-screen">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-0 reveal" id="faq-list" style="border: 1px solid rgba(13,13,13,0.12);">
        {faqs.map((faq, index) => (
          <div class="faq-item" style="border-bottom: 1px solid rgba(13,13,13,0.12);">
            <button
              class="faq-trigger w-full text-left px-6 py-5 flex justify-between items-center gap-4 hover:bg-brand-dark/50 transition-colors focus:outline-none"
              aria-expanded="false"
              data-index={index}
            >
              <span class="font-semibold text-base md:text-lg pr-4">{faq.q}</span>
              <span class="faq-icon flex-shrink-0 w-6 h-6 rounded-full border border-brand-gray/40 flex items-center justify-center text-brand-gray transition-transform duration-300">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </button>
            <div class="faq-body hidden px-6 pb-6 pt-0">
              <p class="text-brand-gray leading-relaxed">{faq.a}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="mt-20 text-center bg-brand-dark rounded-2xl p-10 border border-brand-gray/20">
        <p class="text-brand-gray uppercase tracking-widest text-sm font-medium mb-3">¿Tienes más dudas?</p>
        <h2 class="text-2xl md:text-3xl font-bold mb-4">Hablemos directamente</h2>
        <p class="text-brand-gray mb-8 max-w-md mx-auto">
          Si tu pregunta no está aquí, escríbenos. Te respondemos rápido con una propuesta personalizada.
        </p>
        <a href="/contacto" class="inline-block px-8 py-4 bg-brand-white text-brand-black rounded-md font-bold text-lg hover:bg-brand-beige transition-colors shadow-xl">
          Ir a Contacto
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const triggers = document.querySelectorAll<HTMLButtonElement>('.faq-trigger');

    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        const body = trigger.nextElementSibling as HTMLElement;
        const icon = trigger.querySelector('.faq-icon') as HTMLElement;

        // Cerrar todos los demás
        triggers.forEach(other => {
          if (other !== trigger) {
            other.setAttribute('aria-expanded', 'false');
            const otherBody = other.nextElementSibling as HTMLElement;
            const otherIcon = other.querySelector('.faq-icon') as HTMLElement;
            otherBody?.classList.add('hidden');
            if (otherIcon) otherIcon.style.transform = '';
          }
        });

        if (isOpen) {
          trigger.setAttribute('aria-expanded', 'false');
          body?.classList.add('hidden');
          if (icon) icon.style.transform = '';
        } else {
          trigger.setAttribute('aria-expanded', 'true');
          body?.classList.remove('hidden');
          if (icon) icon.style.transform = 'rotate(180deg)';
        }
      });
    });
  });
</script>
