---
const WA = 'https://wa.me/573117694342';
const EMAIL = 'contacto@dropject.com';
const IG = 'https://instagram.com/dropject';
const SITE_URL = 'https://dropject.com';

const seo = {
  title: 'DropJect | Próximamente — Estampado a otro nivel en Bogotá',
  description:
    'DropJect — Serigrafía premium y producción textil en Bogotá, Colombia. Nueva web en camino. Entérate del lanzamiento y conversemos tu proyecto: WhatsApp, Instagram o correo.',
  keywords:
    'serigrafía Bogotá, estampado premium, producción textil, paquete completo textil, streetwear Colombia, merch artistas, uniformes corporativos, DropJect, próximamente',
  type: 'website'
};

const fullOgImage = `${SITE_URL}/logos/04.png`;
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{seo.title}</title>
  <meta name="title" content={seo.title} />
  <meta name="description" content={seo.description} />
  <meta name="keywords" content={seo.keywords} />
  <meta name="author" content="DropJect" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="googlebot" content="index, follow" />
  <meta name="theme-color" content="#F5F3EF" />
  <link rel="canonical" href={SITE_URL} />
  <meta name="color-scheme" content="light" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />

  <meta property="og:type" content={seo.type} />
  <meta property="og:url" content={SITE_URL} />
  <meta property="og:title" content={seo.title} />
  <meta property="og:description" content={seo.description} />
  <meta property="og:image" content={fullOgImage} />
  <meta property="og:site_name" content="DropJect" />
  <meta property="og:locale" content="es_CO" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={SITE_URL} />
  <meta name="twitter:title" content={seo.title} />
  <meta name="twitter:description" content={seo.description} />
  <meta name="twitter:image" content={fullOgImage} />
  <meta name="twitter:creator" content="@dropject" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
  />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
  />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "DropJect",
    "url": SITE_URL,
    "logo": `${SITE_URL}/logos/04.png`,
    "image": fullOgImage,
    "email": EMAIL,
    "telephone": "+573117694342",
    "description": "Serigrafía premium y producción textil en Bogotá, Colombia. Estampado a otro nivel para marcas exigentes.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Bogotá",
      "addressRegion": "Cundinamarca",
      "addressCountry": "CO"
    },
    "sameAs": [IG, WA]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "DropJect",
    "url": SITE_URL,
    "inLanguage": "es-CO",
    "publisher": { "@type": "Organization", "name": "DropJect" }
  })} />
</head>

<body>
  <a class="skip-link" href="#main">Saltar al contenido</a>

  <header class="site-header">
    <a href="/" class="brand" aria-label="DropJect — Inicio">
      <img src="/logos/05.png" alt="DropJect" style="height:28px;width:auto;object-fit:contain;display:block;" />
      <span class="brand-word">DropJect</span>
    </a>
    <span class="locale">Bogotá · Colombia</span>
  </header>

  <main id="main">
    <!-- ═════ HERO ═════ -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-grid" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>

      <div class="badge-soon">
        <span class="badge-dot" aria-hidden="true"></span>
        <span class="badge-text">Próximamente</span>
        <span class="badge-sep" aria-hidden="true">·</span>
        <span class="badge-sub">Coming Soon</span>
      </div>

      <h1 id="hero-title" class="hero-title" style="margin-top: 1.4rem;">
        DropJect
        <span class="hero-stroke">/ Estampado<br />a&nbsp;otro&nbsp;nivel.</span>
      </h1>

      <p class="lead">
        Serigrafía de alto nivel y producción textil integral para marcas exigentes.
        Estamos afinando cada detalle de la nueva plataforma. Pronto vas a poder
        cotizar, explorar el portafolio y conocer cada técnica premium que ofrecemos.
      </p>

      <form id="notify" class="notify" novalidate>
        <label for="email" class="notify-label">Avísame cuando esté listo</label>
        <div class="notify-field">
          <input
            id="email"
            type="email"
            name="email"
            inputmode="email"
            autocomplete="email"
            placeholder="tu@correo.com"
            required
            aria-required="true"
          />
          <button type="submit" class="btn btn-dark">
            Suscribirme
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
        <p class="notify-foot" aria-live="polite" id="notify-status"></p>
      </form>

      <div class="hero-ctas">
        <span class="asap">¿Tienes un proyecto ya?</span>
        <a class="btn btn-wa" href={WA} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.88-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.347-.272.297-1.04 1.016-1.04 2.479 0 1.463 1.065 2.876 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          Hablar por WhatsApp
        </a>
      </div>
    </section>

    <!-- ═════ MARQUEE ═════ -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        <span>Bogota-Colombia</span><span>Estampado premium</span><span>Serigrafia</span>
        <span>Relieve 3D</span><span>Diseño</span><span>Full Package</span><span>Packing</span>
        <span>Bogota-Colombia</span><span>Estampado premium</span><span>Serigrafia</span>
        <span>Relieve 3D</span><span>Diseño</span><span>Full Package</span><span>Packing</span>
      </div>
    </div>

    <!-- ═════ CREDENTIALS ═════ -->
    <section class="credentials reveal" aria-labelledby="credentials-title">
      <div class="credentials-heading">
        <div>
          <p class="credentials-eyebrow">El respaldo de cada proyecto</p>
          <h2 id="credentials-title">Hecho para marcas<br/>que quieren destacar.</h2>
        </div>
        <p class="credentials-hint">Desliza para explorar <span aria-hidden="true">→</span></p>
      </div>
      <div class="stats">
        <article class="stat" tabindex="0">
          <div class="stat-top">
            <p class="stat-num">01</p>
            <span class="stat-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l2.5 2.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </span>
          </div>
          <div class="stat-summary">
            <p class="stat-val">+18</p>
            <p class="stat-lbl">Años de experiencia</p>
          </div>
          <div class="stat-content">
            <p class="stat-detail">Transformamos ideas en prendas que destacan. Nuestra trayectoria respalda procesos confiables, acabados impecables y soluciones pensadas para marcas de moda.</p>
          </div>
        </article>
        <article class="stat" tabindex="0">
          <div class="stat-top">
            <p class="stat-num">02</p>
            <span class="stat-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19l5.5-5.5 3.5 3.5L20 9.5M17 9.5H20V12.5"/></svg>
            </span>
          </div>
          <div class="stat-summary">
            <p class="stat-val">+30</p>
            <p class="stat-lbl">Técnicas de estampado</p>
          </div>
          <div class="stat-content">
            <p class="stat-detail">La técnica ideal para cada diseño. Sin límite de colores, ofrecemos múltiples alternativas de estampación para lograr color, textura, durabilidad y personalidad en cada prenda.</p>
          </div>
        </article>
        <article class="stat" tabindex="0">
          <div class="stat-top">
            <p class="stat-num">03</p>
            <span class="stat-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6l9-3 9 3-9 3-9-3zm0 6l9 3 9-3m-18 6l9 3 9-3"/></svg>
            </span>
          </div>
          <div class="stat-summary">
            <p class="stat-val">100%</p>
            <p class="stat-lbl">Colombianos</p>
          </div>
          <div class="stat-content">
            <p class="stat-detail">Diseñamos y producimos con talento colombiano. Calidad local, atención cercana y una cadena de producción comprometida con cada proyecto.</p>
          </div>
        </article>
        <article class="stat" tabindex="0">
          <div class="stat-top">
            <p class="stat-num">04</p>
            <span class="stat-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 12.75l1.5 1.5 3-3m5.25-4.5a9 9 0 11-12 0 9 9 0 0112 0z"/></svg>
            </span>
          </div>
          <div class="stat-summary">
            <p class="stat-val">+20</p>
            <p class="stat-lbl">Empresas confían en nosotros</p>
          </div>
          <div class="stat-content">
            <p class="stat-detail">Acompañamos a más de 20 marcas y empresas en la mejor estampación en serigrafía y la creación de prendas que representan su identidad. Experiencia, cumplimiento y resultados que generan confianza.</p>
            <a class="stat-link" href="/portafolio">Conoce nuestros proyectos <span aria-hidden="true">→</span></a>
          </div>
        </article>
      </div>
    </section>

    <!-- ═════ WHAT'S COMING ═════ -->
    <section class="coming reveal" aria-labelledby="coming-title">
      <p class="eyebrow centered"><span class="dash"></span>Lo que viene<span class="dash"></span></p>
      <h2 id="coming-title" class="section-title">Una experiencia<br />a la altura de la marca.</h2>
      <ul class="coming-list">
        <li>
          <span class="coming-tag">Servicio</span>
          <h3>Estampado en serigrafía</h3>
          <p>Plastisol, 3D, Flock, Reflectivo, Glow in the Dark y más. Traes tu prenda, nosotros ponemos el arte.</p>
        </li>
        <li>
          <span class="coming-tag">Full-Pack</span>
          <h3>Paquete completo textil</h3>
          <p>Del patronaje y las fichas técnicas hasta la entrega final empaquetada. Producción end-to-end.</p>
        </li>
        <li>
          <span class="coming-tag">Galería</span>
          <h3>Portafolio de resultados</h3>
          <p>Colecciones y casos reales de marcas que ya confiaron en DropJect. Inspiración antes de cotizar.</p>
        </li>
        <li>
          <span class="coming-tag">Cotización</span>
          <h3>Cotiza online en minutos</h3>
          <p>Cuéntanos servicio, prendas y cantidades. Respuesta en menos de 24 horas con la mejor propuesta.</p>
        </li>
      </ul>
    </section>
  </main>

  <footer class="site-footer">
    <div class="foot-brand">
      <a href="/" class="brand" aria-label="DropJect — Inicio">
        <img src="/logos/05.png" alt="DropJect" style="height:18px;width:auto;object-fit:contain;display:block;" />
        <span class="brand-word">DropJect</span>
      </a>
      <p class="foot-copy">&copy; {new Date().getFullYear()} DropJect. Estampado a otro nivel.</p>
    </div>

    <nav class="foot-contacts" aria-label="Contacto">
      <a href={WA} target="_blank" rel="noopener noreferrer">WhatsApp · +57 311 769 4342</a>
      <a href={IG} target="_blank" rel="noopener noreferrer">Instagram · @dropject</a>
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
    </nav>
  </footer>

  <script>
    const reveal = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); reveal.unobserve(e.target); } });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => reveal.observe(el));

    const form = document.getElementById('notify');
    const status = document.getElementById('notify-status');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = form.querySelector('input[type="email"]');
      const value = (input?.value || '').trim();
      const ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
      if (!ok) {
        if (status) status.textContent = 'Ingresa un correo válido, por favor.';
        input?.focus();
        return;
      }
      const subject = encodeURIComponent('Suscripción al lanzamiento DropJect');
      const body = encodeURIComponent(`Avísenme cuando el sitio esté listo. Mi correo: ${value}`);
      window.location.href = `mailto:contacto@dropject.com?subject=${subject}&body=${body}`;
      if (status) status.textContent = 'Abriendo tu cliente de correo… Gracias.';
      form.reset();
    });
  </script>
</body>
</html>

<style>
  :root {
    --brand-black: #F5F3EF;
    --brand-dark:  #D9D6CF;
    --brand-gray:  #8C8B88;
    --brand-light: #BFBDB8;
    --brand-beige: #413F3D;
    --brand-white: #0D0D0D;
    --line: rgba(13,13,13,0.12);
    --maxw: 1120px;
    --font-head: 'Inter', sans-serif;
    --font-body: 'Inter', system-ui, sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    min-height: 100%;
    background: var(--brand-black);
    color: var(--brand-white);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    overflow-x: hidden;
  }
  body::before {
    content: '';
    position: fixed; inset: 0; z-index: 9999;
    pointer-events: none; opacity: .18; mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
  }
  a { color: inherit; }
  img, svg { display: block; }

  .skip-link {
    position: absolute; left: -999px; top: 0; z-index: 10000;
    background: var(--brand-white); color: var(--brand-black);
    padding: .5rem 1rem; font-size: .8rem;
  }
  .skip-link:focus { left: 1rem; top: 1rem; }

  /* ── HEADER ── */
  .site-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.4rem 2rem; position: relative; z-index: 5;
  }
  .brand { display: inline-flex; align-items: center; gap: .55rem; text-decoration: none; color: var(--brand-white); }
  .brand-mark { flex-shrink: 0; }
  .brand-word {
    font-family: var(--font-head); font-weight: 700;
    letter-spacing: .22em; text-transform: uppercase; font-size: .82rem;
  }
  .locale {
    font-size: .62rem; letter-spacing: .18em; text-transform: uppercase;
    color: var(--brand-gray); font-family: var(--font-body);
  }

  /* ── EYEBROW ── */
  .eyebrow {
    font-size: .66rem; letter-spacing: .2em; text-transform: uppercase;
    color: var(--brand-gray); display: flex; align-items: center; gap: 1rem;
    font-family: var(--font-body); margin: 0 0 1.6rem;
  }
  .eyebrow.centered { justify-content: center; }
  .dash { display: block; width: 2rem; height: 1px; background: currentColor; flex-shrink: 0; }

  /* ── BADGE PRÓXIMAMENTE ── */
  .badge-soon {
    display: inline-flex; align-items: center; gap: .55rem;
    padding: .55rem 1.1rem;
    background: var(--brand-white); color: var(--brand-black);
    font-family: var(--font-head); font-weight: 600;
    font-size: .72rem; letter-spacing: .22em; text-transform: uppercase;
    border: 1px solid var(--brand-white);
    margin-bottom: 1.6rem;
    position: relative;
    animation: badge-pulse 2.6s ease-in-out infinite;
  }
  .badge-soon::before, .badge-soon::after {
    content: ''; position: absolute; width: 8px; height: 8px;
    border: 1px solid var(--brand-white);
  }
  .badge-soon::before { top: -4px; left: -4px; border-right: 0; border-bottom: 0; }
  .badge-soon::after  { bottom: -4px; right: -4px; border-left: 0; border-top: 0; }
  .badge-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #25D366; box-shadow: 0 0 0 0 rgba(37,211,102,.7);
    animation: ping 1.6s cubic-bezier(0,0,.2,1) infinite;
  }
  .badge-sep { opacity: .5; }
  .badge-sub { opacity: .55; font-weight: 500; }
  @keyframes ping {
    0%   { box-shadow: 0 0 0 0 rgba(37,211,102,.6); }
    70%  { box-shadow: 0 0 0 7px rgba(37,211,102,0); }
    100% { box-shadow: 0 0 0 0 rgba(37,211,102,0); }
  }
  @keyframes badge-pulse {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-3px); }
  }

  /* ── HERO ── */
  .hero {
    position: relative;
    min-height: calc(100vh - 64px);
    padding: 5rem 2rem 6rem;
    display: flex; flex-direction: column; justify-content: center; align-items: flex-start;
    max-width: var(--maxw); margin: 0 auto; z-index: 2;
  }
  .hero-grid {
    position: absolute; inset: 0 -2rem; pointer-events: none;
    display: grid; grid-template-columns: repeat(6, 1fr);
    z-index: -1;
  }
  .hero-grid span { border-right: 1px solid var(--line); }
  .hero-grid span:last-child { border-right: 0; }

  .hero-title {
    font-family: var(--font-head); font-weight: 700;
    font-size: clamp(3.4rem, 9vw, 8.5rem);
    line-height: .9; letter-spacing: -.03em; text-transform: uppercase;
    margin: 0 0 2rem; color: var(--brand-white);
  }
  .hero-stroke {
    display: block; margin-top: .2rem; line-height: 1.12;
    color: var(--brand-gray);
  }
  .lead {
    max-width: 560px; color: var(--brand-gray);
    font-size: 1rem; line-height: 1.75; margin: 0 0 2.4rem;
  }

  /* ── NOTIFY ── */
  .notify { width: 100%; max-width: 520px; margin: 0 0 2.2rem; }
  .notify-label {
    display: block; font-size: .66rem; letter-spacing: .2em; text-transform: uppercase;
    color: var(--brand-gray); margin-bottom: .7rem;
  }
  .notify-field { display: flex; gap: .5rem; }
  .notify-field input {
    flex: 1; min-width: 0;
    background: transparent; color: var(--brand-white);
    border: 1px solid var(--line); border-radius: 0;
    padding: 1rem 1.1rem; font: inherit; font-size: .95rem;
    transition: border-color .2s;
  }
  .notify-field input::placeholder { color: var(--brand-light); }
  .notify-field input:focus { outline: none; border-color: var(--brand-white); }
  .notify-foot { margin: .7rem 0 0; font-size: .75rem; color: var(--brand-gray); min-height: 1.1em; }

  .btn {
    display: inline-flex; align-items: center; gap: .55rem;
    font-family: var(--font-head); font-size: .72rem; font-weight: 600;
    letter-spacing: .14em; text-transform: uppercase; text-decoration: none;
    padding: 1rem 1.5rem; border: 1px solid transparent; cursor: pointer;
    transition: background .2s, color .2s, transform .2s;
  }
  .btn svg { width: 16px; height: 16px; }
  .btn-dark { background: var(--brand-white); color: var(--brand-black); }
  .btn-dark:hover { background: var(--brand-beige); color: #fff; transform: translateY(-2px); }
  .btn-wa { background: #25D366; color: #fff; }
  .btn-wa:hover { background: #20BE5C; transform: translateY(-2px); }
  .btn-wa svg { width: 18px; height: 18px; }

  .hero-ctas { display: flex; align-items: center; gap: 1.4rem; flex-wrap: wrap; }
  .asap { font-size: .8rem; color: var(--brand-gray); }

  /* ── MARQUEE ── */
