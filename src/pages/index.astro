---
import Layout from '../layouts/Layout.astro';

const seo = {
	title: 'DropJect | Sublimación Industrial y Dotaciones Corporativas en Bogotá',
	description: 'Especialistas en sublimación de alta calidad en Bogotá. Dotaciones corporativas, uniformes, material POP y producción textil con colores vibrantes y durabilidad garantizada. ¡Cotiza hoy!',
	keywords: 'sublimación Bogotá, dotaciones corporativas, uniformes empresariales, serigrafía, estampado textil, material POP, merchandising, producción textil',
	canonicalURL: '/',
	type: 'website'
};
---

<Layout seo={seo}>
  <!-- Hero Section -->
  <section class="relative bg-brand-black w-full min-h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_center,_var(--color-brand-gray)_0%,_transparent_70%)]"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center z-10 flex flex-col items-center">
      <p class="text-brand-gray uppercase tracking-widest text-sm font-medium mb-4">Serigrafía de alto nivel</p>
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 tracking-tight leading-tight">
        DROPJECT / Estampado a otro nivel.
      </h1>
      <p class="mt-4 text-xl text-brand-gray max-w-2xl mx-auto mb-6">
        Drops de moda con calidad, estampados en serigrafía a otro nivel.
      </p>
      <p class="text-brand-gray/70 italic text-base max-w-xl mx-auto mb-10">
        "DROPJECT, estampado a otro nivel, prendas para las mejores marcas."
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contacto" class="px-8 py-3 bg-white text-brand-black rounded-md font-semibold text-lg hover:bg-brand-beige transition-all shadow-[0_0_20px_rgba(255,255,255,0.2)]">
          Cotizar Ahora
        </a>
        <a href="/servicios" class="px-8 py-3 bg-brand-dark/50 text-white border border-brand-gray rounded-md font-semibold text-lg hover:bg-brand-dark transition-all">
          Ver Servicios
        </a>
      </div>
    </div>
  </section>
</Layout>
