---
const siteUrl = 'https://dropject.com';
const title = 'Cotiza tu proyecto | DropJect';
const description = 'Cuéntanos sobre tu proyecto de estampado o producción textil y recibe una respuesta de DropJect.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#F5F3EF" />
    <title>{title}</title>
    <link rel="canonical" href={`${siteUrl}/contacto`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al formulario</a>
    <header class="site-header">
      <a href="/" class="brand" aria-label="DropJect, ir al inicio">
        <img src="/logos/05.png" alt="DropJect" width="28" height="28" />
        <span>DropJect</span>
      </a>
      <a class="back-link" href="/">Volver al inicio <span aria-hidden="true">&#8592;</span></a>
    </header>

    <main id="main" class="contact-page">
      <section class="contact-intro" aria-labelledby="contact-title">
        <p class="eyebrow"><span></span>Cotización</p>
        <h1 id="contact-title">Hablemos de<br /><span>tu proyecto.</span></h1>
        <p>Cuéntanos qué necesitas. Revisaremos tu solicitud y te responderemos con los siguientes pasos.</p>
        <div class="direct-links">
          <a href="https://wa.me/573117694342" target="_blank" rel="noopener noreferrer">WhatsApp <span aria-hidden="true">&#8599;</span></a>
          <a href="mailto:contacto@dropject.com">contacto@dropject.com <span aria-hidden="true">&#8599;</span></a>
        </div>
      </section>

      <section class="form-panel" aria-labelledby="form-title">
        <div class="form-heading">
          <p>01 / Cuéntanos</p>
          <h2 id="form-title">Solicita tu cotización</h2>
        </div>
        <form id="contact-form" action="https://formsubmit.co/ajax/contacto@dropject.com" method="post" novalidate>
          <input type="hidden" name="form" value="quote" />
          <input type="hidden" name="_subject" value="Nueva cotización | DropJect" />
          <input type="hidden" name="_template" value="table" />
          <div class="honeypot" aria-hidden="true">
            <label for="website">No completes este campo</label>
            <input id="website" name="_honey" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="form-grid">
            <label>Nombre <span aria-hidden="true">*</span><input name="name" type="text" autocomplete="name" maxlength="100" required placeholder="Tu nombre" /></label>
            <label>Marca o empresa <span aria-hidden="true">*</span><input name="brand" type="text" autocomplete="organization" maxlength="120" required placeholder="Nombre de tu marca" /></label>
            <label>Correo electrónico <span aria-hidden="true">*</span><input name="email" type="email" inputmode="email" autocomplete="email" maxlength="254" required placeholder="tu@correo.com" /></label>
            <label>WhatsApp o teléfono <span aria-hidden="true">*</span><input name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="40" required placeholder="+57 300 123 4567" /></label>
          </div>

          <fieldset>
            <legend>Servicio <span aria-hidden="true">*</span></legend>
            <div class="service-options">
              <label class="service-option"><input type="radio" name="service" value="estampado" required /><span><b>Estampado en serigrafía</b><small>Producción y estampado de prendas con técnicas premium.</small></span></label>
              <label class="service-option"><input type="radio" name="service" value="paquete-completo" /><span><b>Paquete completo</b><small>De patronaje y fichas técnicas a entrega final empaquetada.</small></span></label>
            </div>
          </fieldset>

          <div class="form-grid form-grid-bottom">
            <label>Cantidad aproximada <span aria-hidden="true">*</span><input name="quantity" type="number" inputmode="numeric" min="1" max="999999" required placeholder="Ej: 50" /></label>
            <label class="message-field">Detalles del proyecto<textarea name="message" rows="4" maxlength="2000" placeholder="Tipo de prenda, diseño, colores, fecha de entrega o referencias."></textarea></label>
          </div>

          <div class="form-footer">
            <p>Tus datos se usarán únicamente para gestionar esta solicitud.</p>
            <button type="submit"><span>Enviar cotización</span> <i aria-hidden="true">&#8594;</i></button>
          </div>
          <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </section>
    </main>

    <footer class="site-footer">
      <div><a href="/" class="brand"><img src="/logos/05.png" alt="DropJect" width="18" height="18" /><span>DropJect</span></a><p>&copy; {new Date().getFullYear()} DropJect. Estampado a otro nivel.</p></div>
      <nav><a href="https://wa.me/573117694342" target="_blank" rel="noopener noreferrer">WhatsApp</a><a href="https://instagram.com/dropject" target="_blank" rel="noopener noreferrer">Instagram</a><a href="mailto:contacto@dropject.com">Correo</a></nav>
    </footer>

    <script>
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const status = document.getElementById('form-status');
      const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
      const serviceOptions = form?.querySelectorAll<HTMLInputElement>('input[name="service"]');

      const setServiceStyles = () => serviceOptions?.forEach((input) => input.closest('.service-option')?.classList.toggle('selected', input.checked));
      serviceOptions?.forEach((input) => input.addEventListener('change', setServiceStyles));

      const service = new URLSearchParams(window.location.search).get('servicio');
      const matchedService = serviceOptions ? Array.from(serviceOptions).find((input) => input.value === service) : undefined;
      if (matchedService) {
        matchedService.checked = true;
        setServiceStyles();
      }

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;

        if (status) status.textContent = 'Enviando tu solicitud...';
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.setAttribute('aria-busy', 'true');
        }

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          });
          const result = await response.json();
          if (!response.ok || (result.success !== true && result.success !== 'true')) throw new Error('No pudimos enviar tu solicitud.');

          form.reset();
          setServiceStyles();
          if (status) status.textContent = 'Recibimos tu solicitud. Te contactaremos pronto.';
        } catch (error) {
          if (status) status.textContent = error instanceof Error ? error.message : 'No pudimos enviar tu solicitud. Inténtalo de nuevo o escríbenos por WhatsApp.';
        } finally {
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.removeAttribute('aria-busy');
          }
        }
      });
    </script>
  </body>
</html>

<style>
  :root { --ink:#0d0d0d; --paper:#f5f3ef; --soft:#d9d6cf; --muted:#6e6c68; --line:rgba(13,13,13,.13); --max:1120px; font-family:Inter,system-ui,sans-serif; color:var(--ink); background:var(--paper); }
  * { box-sizing:border-box; } body { margin:0; background:var(--paper); color:var(--ink); } a { color:inherit; } .skip-link { left:-999px; position:absolute; z-index:20; } .skip-link:focus { background:var(--ink); color:var(--paper); left:1rem; padding:.5rem 1rem; top:1rem; }
  .site-header,.site-footer,.contact-page { margin:auto; max-width:var(--max); } .site-header { align-items:center; backdrop-filter:blur(12px); background:rgba(245,243,239,.92); border-bottom:1px solid var(--line); display:flex; justify-content:space-between; left:0; max-width:none; min-height:5.6rem; padding:1.25rem max(2rem,calc((100vw - var(--max)) / 2)); position:sticky; top:0; z-index:10; } .brand { align-items:center; display:inline-flex; font-size:.8rem; font-weight:700; gap:.55rem; letter-spacing:.18em; text-decoration:none; text-transform:uppercase; } .brand img { object-fit:contain; } .back-link { font-size:.66rem; font-weight:600; letter-spacing:.13em; text-decoration:none; text-transform:uppercase; } .back-link span { display:inline-block; margin-left:.35rem; }
  .contact-page { display:grid; gap:3rem; grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr); min-height:calc(100vh - 5.6rem); padding:5rem 2rem 6rem; } .contact-intro { align-self:start; padding-top:1rem; } .eyebrow,.form-heading p { align-items:center; color:var(--muted); display:flex; font-size:.65rem; font-weight:600; gap:.6rem; letter-spacing:.16em; margin:0 0 1.5rem; text-transform:uppercase; } .eyebrow span { background:#25d366; border-radius:50%; box-shadow:0 0 0 .25rem rgba(37,211,102,.15); height:.5rem; width:.5rem; } .contact-intro h1 { font-size:clamp(2.8rem,5.5vw,5.4rem); font-weight:700; letter-spacing:-.055em; line-height:.92; margin:0 0 1.7rem; text-transform:uppercase; } .contact-intro h1 span { color:var(--muted); } .contact-intro > p:not(.eyebrow) { color:var(--muted); font-size:.95rem; line-height:1.75; margin:0; max-width:27rem; } .direct-links { border-top:1px solid var(--line); display:flex; flex-direction:column; gap:.85rem; margin-top:2.5rem; padding-top:1.3rem; } .direct-links a { font-size:.7rem; font-weight:600; letter-spacing:.12em; text-decoration:none; text-transform:uppercase; } .direct-links span { color:var(--muted); margin-left:.35rem; }
  .form-panel { border:1px solid var(--line); padding:2rem; } .form-heading { border-bottom:1px solid var(--line); margin-bottom:2rem; padding-bottom:1.5rem; } .form-heading p { margin-bottom:.75rem; } .form-heading h2 { font-size:clamp(1.5rem,3vw,2rem); letter-spacing:-.035em; margin:0; text-transform:uppercase; } form { display:flex; flex-direction:column; gap:1.8rem; } .form-grid { display:grid; gap:1.25rem; grid-template-columns:1fr 1fr; } label,legend { display:block; font-size:.65rem; font-weight:600; letter-spacing:.12em; text-transform:uppercase; } label span,legend span { color:var(--muted); } input,textarea { background:transparent; border:0; border-bottom:1px solid var(--line); border-radius:0; color:var(--ink); display:block; font:400 .94rem Inter,system-ui,sans-serif; letter-spacing:normal; margin-top:.65rem; outline:0; padding:.75rem 0; text-transform:none; width:100%; } textarea { line-height:1.5; resize:vertical; } input:focus,textarea:focus { border-color:var(--ink); box-shadow:0 1px 0 var(--ink); } input::placeholder,textarea::placeholder { color:#8d8b86; } fieldset { border:0; margin:0; padding:0; } legend { margin-bottom:.8rem; } .service-options { display:grid; gap:.75rem; grid-template-columns:1fr 1fr; } .service-option { border:1px solid var(--line); cursor:pointer; padding:1rem; transition:background .2s,border-color .2s; } .service-option:hover,.service-option.selected { background:var(--soft); border-color:var(--ink); } .service-option input { appearance:none; height:1px; margin:0; opacity:0; position:absolute; width:1px; } .service-option:has(input:focus-visible) { outline:2px solid var(--ink); outline-offset:2px; } .service-option b { display:block; font-size:.72rem; letter-spacing:.08em; margin-bottom:.5rem; } .service-option small { color:var(--muted); display:block; font-size:.75rem; font-weight:400; letter-spacing:0; line-height:1.5; text-transform:none; } .message-field { grid-column:span 1; } .form-footer { align-items:center; border-top:1px solid var(--line); display:flex; gap:1.5rem; justify-content:space-between; padding-top:1.5rem; } .form-footer p { color:var(--muted); font-size:.72rem; line-height:1.5; margin:0; max-width:19rem; } button { background:var(--ink); border:1px solid var(--ink); color:var(--paper); cursor:pointer; font:600 .68rem Inter,system-ui,sans-serif; letter-spacing:.13em; padding:1rem 1.2rem; text-transform:uppercase; transition:background .2s,color .2s; } button:hover:not(:disabled) { background:transparent; color:var(--ink); } button:disabled { cursor:wait; opacity:.6; } button i { font-size:1rem; font-style:normal; margin-left:.4rem; } .form-status { color:var(--muted); font-size:.8rem; line-height:1.5; margin:-.8rem 0 0; min-height:1.2rem; } .honeypot { height:1px; left:-9999px; overflow:hidden; position:absolute; width:1px; }
  .site-footer { align-items:center; border-top:1px solid var(--line); display:flex; gap:2rem; justify-content:space-between; padding:2.4rem 2rem; } .site-footer p { color:var(--muted); font-size:.68rem; margin:.6rem 0 0; } .site-footer nav { display:flex; flex-wrap:wrap; gap:1.25rem; } .site-footer nav a { color:var(--muted); font-size:.66rem; letter-spacing:.1em; text-decoration:none; text-transform:uppercase; }
  @media (max-width:760px) { .site-header { min-height:4.8rem; padding:1rem 1.3rem; } .back-link { font-size:.6rem; } .contact-page { display:block; padding:3.5rem 1.3rem 5rem; } .contact-intro { padding:0 0 3.5rem; } .form-panel { padding:1.3rem; } .form-grid,.service-options { grid-template-columns:1fr; } .message-field { grid-column:auto; } .form-footer { align-items:stretch; flex-direction:column; } .form-footer button { width:100%; } .site-footer { align-items:flex-start; flex-direction:column; padding:2rem 1.3rem; } }
  @media (prefers-reduced-motion:reduce) { *,*::before,*::after { scroll-behavior:auto!important; transition-duration:.01ms!important; } }
</style>
