---
import Layout from '../layouts/Layout.astro';

const seo = {
	title: 'Nosotros | DropJect - 18 Años de Experiencia en Serigrafía',
	description: 'Más de 18 años de experiencia en la industria textil. Alianzas sólidas, estampación premium y servicio de full-packing textil de alto nivel para las mejores marcas.',
	keywords: 'sobre DropJect, empresa de serigrafía, taller de serigrafía Colombia, experiencia estampado textil, full-packing textil, historia DropJect',
	canonicalURL: '/nosotros',
	type: 'website'
};
---

<Layout seo={seo}>
  <section class="bg-brand-black pt-32 pb-16 px-4 sm:px-6 lg:px-8 text-center border-b border-brand-dark">
    <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Sobre Nosotros</h1>
    <p class="text-brand-gray max-w-2xl mx-auto text-lg">
      Más de 18 años de experiencia en la industria textil y serigráfica en Colombia.
    </p>
  </section>

  <section class="py-24 bg-brand-light text-brand-black min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl md:text-5xl font-bold mb-6 tracking-tight">18 años<br/>de experiencia.</h2>
          <p class="text-brand-dark mb-8 text-lg leading-relaxed">
            Con más de 18 años de experiencia en la industria textil, ofrecemos a nuestros clientes alianzas sólidas y duraderas. Nuestra pasión por la moda se refleja en la más alta calidad de estampación, técnicas innovadoras y un servicio de full-packing textil de alto nivel.
          </p>
          <ul class="space-y-4 mb-10">
            <li class="flex items-center gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-brand-black text-white flex items-center justify-center text-xs">✓</span>
              <span class="font-medium">Técnicas innovadoras de estampación premium.</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-brand-black text-white flex items-center justify-center text-xs">✓</span>
              <span class="font-medium">Servicio de full-packing textil de alto nivel.</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-brand-black text-white flex items-center justify-center text-xs">✓</span>
              <span class="font-medium">Pasión por la moda en cada prenda que producimos.</span>
            </li>
          </ul>

          <a href="/contacto" class="px-8 py-4 bg-brand-black text-white rounded-md font-bold text-lg hover:bg-brand-dark transition-all shadow-xl inline-block">
            Hablar con Nosotros
          </a>
        </div>
        <div class="aspect-[4/3] bg-brand-beige rounded-2xl flex items-center justify-center shadow-lg overflow-hidden relative group">
          <div class="absolute inset-0 bg-brand-dark/20 group-hover:bg-transparent transition-colors z-10"></div>
          <span class="text-brand-gray/50 font-medium z-0">Foto del Taller Serigráfico</span>
        </div>
      </div>
    </div>
  </section>
</Layout>
