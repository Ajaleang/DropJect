---
import SEO from '../components/SEO.astro';
import ClientPortfolio from '../components/ClientPortfolio.astro';

const siteUrl = 'https://dropject.com';
const title = 'Marcas que confían en DropJect | Portafolio';
const description = 'Conoce algunas de las marcas que han confiado en DropJect para dar vida a sus ideas y proyectos textiles.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F5F3EF" />
    <SEO
      title={title}
      description={description}
      canonicalURL="/portafolio"
      keywords="marcas DropJect, clientes, portafolio textil, serigrafía, estampado Bogotá"
    />
    <link rel="alternate" hreflang="es" href={`${siteUrl}/portafolio`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/en/portfolio`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/portafolio`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  </head>
  <body>
    <ClientPortfolio locale="es" />
  </body>
</html>
