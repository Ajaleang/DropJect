---
import Layout from '../layouts/Layout.astro';

const seo = {
	title: 'Servicios | Estampado en Serigrafía y Paquete Completo - DropJect',
	description: 'Servicios de serigrafía de alto nivel: estampado en múltiples técnicas y paquete completo con patronaje, confección y entrega. Prendas para las mejores marcas.',
	keywords: 'serigrafía, estampado, paquete completo, patronaje, confección, full-packing textil, serigrafía Colombia, DropJect servicios',
	canonicalURL: '/servicios',
	type: 'website'
};
---

<Layout seo={seo}>
  <section class="bg-brand-black pt-32 pb-16 px-4 sm:px-6 lg:px-8 text-center border-b border-brand-dark">
    <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Servicios</h1>
    <p class="text-brand-gray max-w-2xl mx-auto text-lg">
      Serigrafía de alto nivel y producción textil completa para marcas exigentes.
    </p>
  </section>

  <section class="py-24 bg-brand-black text-white min-h-screen">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- Servicio 1: Estampado en Serigrafía -->
        <div class="bg-white text-brand-black rounded-2xl p-10 flex flex-col shadow-lg">
          <h2 class="text-2xl font-bold mb-6">Estampado en Serigrafía</h2>
          <ul class="space-y-4 flex-grow mb-8">
            <li class="flex items-start gap-3">
              <span class="text-brand-black font-bold mt-0.5">✔</span>
              <span>Producción y colecciones en múltiples técnicas de estampación.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-black font-bold mt-0.5">✔</span>
              <span>Separación de diseños y artes listas para impresión.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-black font-bold mt-0.5">✔</span>
              <span>Dirección creativa y desarrollo de diseños exclusivos para tus colecciones.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-black font-bold mt-0.5">✔</span>
              <span>Fotografías de los estampados elegidos para visualizar resultados.</span>
            </li>
          </ul>
          <a href="/contacto?servicio=estampado" class="mt-auto block text-center px-6 py-3 bg-brand-black text-white rounded-md font-semibold hover:bg-brand-dark transition-colors">
            Cotizar Estampado
          </a>
        </div>

        <!-- Servicio 2: Paquete Completo -->
        <div class="bg-brand-black text-white rounded-2xl p-10 flex flex-col border border-white/20 shadow-lg relative overflow-hidden">
          <span class="absolute top-5 right-5 text-xs font-bold uppercase tracking-widest bg-white text-brand-black px-3 py-1 rounded-full">Full-Pack</span>
          <h2 class="text-2xl font-bold mb-6">Paquete Completo</h2>
          <ul class="space-y-4 flex-grow mb-8">
            <li class="flex items-start gap-3">
              <span class="text-white font-bold mt-0.5">✔</span>
              <span>Creación de patronaje y moldes para confección.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-white font-bold mt-0.5">✔</span>
              <span>Elaboración de fichas técnicas textiles.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-white font-bold mt-0.5">✔</span>
              <span>Reunión personalizada para selección de telas y accesorios.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-white font-bold mt-0.5">✔</span>
              <span>Realización de muestras previas.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-white font-bold mt-0.5">✔</span>
              <span>Producción completa de la colección.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-white font-bold mt-0.5">✔</span>
              <span>Entrega final en packaging solicitado, organizado por referencia, tallas y diseño.</span>
            </li>
          </ul>
          <a href="/contacto?servicio=paquete-completo" class="mt-auto block text-center px-6 py-3 bg-white text-brand-black rounded-md font-semibold hover:bg-brand-beige transition-colors">
            Cotizar Paquete Completo
          </a>
        </div>

      </div>
    </div>
  </section>
</Layout>
