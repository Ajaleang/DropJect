---
import Layout from '../layouts/Layout.astro';

const seo = {
	title: 'Servicios | Estampado en Serigrafía y Paquete Completo - DropJect',
	description: 'Servicios de serigrafía de alto nivel: estampado en múltiples técnicas y paquete completo con patronaje, confección y entrega. Prendas para las mejores marcas.',
	keywords: 'serigrafía, estampado, paquete completo, patronaje, confección, full-packing textil, serigrafía Colombia, DropJect servicios',
	canonicalURL: '/servicios',
	type: 'website'
};
---

<Layout seo={seo}>
  <section class="page-hero">
    <p class="page-hero-label">Servicios</p>
    <h1 class="page-hero-h1">Serigrafía &<br/>Producción Textil</h1>
    <p class="page-hero-desc">Serigrafía de alto nivel y producción textil completa para marcas exigentes.</p>
  </section>

  <section class="py-24 bg-[var(--black)] text-white min-h-screen">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bordered-grid reveal" style="grid-template-columns: 1fr 1fr;">

        <!-- Servicio 1: Estampado en Serigrafía -->
        <div class="bordered-cell bg-[var(--white)] text-[var(--black)] flex flex-col" style="border-bottom: none;">
          <h2 class="service-page-title">Estampado en Serigrafía</h2>
          <ul class="space-y-4 flex-grow mb-8">
            <li class="flex items-start gap-3">
              <span class="text-brand-black font-bold mt-0.5">✔</span>
              <span>Producción y colecciones en múltiples técnicas de estampación.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-black font-bold mt-0.5">✔</span>
              <span>Separación de diseños y artes listas para impresión.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-black font-bold mt-0.5">✔</span>
              <span>Dirección creativa y desarrollo de diseños exclusivos para tus colecciones.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-black font-bold mt-0.5">✔</span>
              <span>Fotografías de los estampados elegidos para visualizar resultados.</span>
            </li>
          </ul>
          <a href="/contacto?servicio=estampado" class="mt-auto block text-center px-6 py-3 bg-[var(--black)] text-[var(--white)] hover:bg-[var(--dark)] transition-colors" style="font-family:'Space Grotesk',sans-serif;font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;">
            Cotizar Estampado
          </a>
        </div>

        <!-- Servicio 2: Paquete Completo -->
        <div class="bordered-cell bg-[var(--dark)] text-white flex flex-col relative overflow-hidden" style="border-right: none; border-bottom: none;">
          <span class="service-page-badge">Full-Pack</span>
          <h2 class="service-page-title service-page-title--light">Paquete Completo</h2>
          <ul class="space-y-4 flex-grow mb-8">
            <li class="flex items-start gap-3">
              <span class="text-white font-bold mt-0.5">✔</span>
              <span>Creación de patronaje y moldes para confección.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-white font-bold mt-0.5">✔</span>
              <span>Elaboración de fichas técnicas textiles.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-white font-bold mt-0.5">✔</span>
              <span>Reunión personalizada para selección de telas y accesorios.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-white font-bold mt-0.5">✔</span>
              <span>Realización de muestras previas.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-white font-bold mt-0.5">✔</span>
              <span>Producción completa de la colección.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-white font-bold mt-0.5">✔</span>
              <span>Entrega final en packaging solicitado, organizado por referencia, tallas y diseño.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-white font-bold mt-0.5">✔</span>
              <span>Información infográfica de cada servicio para mayor claridad.</span>
            </li>
          </ul>
          <a href="/contacto?servicio=paquete-completo" class="mt-auto block text-center px-6 py-3 bg-[var(--white)] text-[var(--black)] font-semibold hover:bg-[var(--light)] transition-colors" style="font-family:'Space Grotesk',sans-serif;font-size:0.75rem;letter-spacing:0.1em;text-transform:uppercase;">
            Cotizar Paquete Completo
          </a>
        </div>

      </div>
    </div>
  </section>
</Layout>

<style>
  .service-page-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--black);
    margin-bottom: 1.5rem;
  }
  .service-page-title--light { color: var(--white); }
  .service-page-badge {
    position: absolute;
    top: 1.5rem; right: 1.5rem;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--white);
    color: var(--black);
    padding: 0.3rem 0.75rem;
    font-family: 'Space Grotesk', sans-serif;
  }
  @media (max-width: 768px) {
    .bordered-grid { grid-template-columns: 1fr !important; }
    .bordered-cell { border-right: none !important; }
  }
</style>
