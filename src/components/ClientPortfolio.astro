---
import FloatingWhatsApp from './FloatingWhatsApp.astro';

export type PortfolioLocale = 'es' | 'en';

interface Props {
  locale: PortfolioLocale;
}

const { locale } = Astro.props;
const isEnglish = locale === 'en';

const copy = isEnglish ? {
  skip: 'Skip to content',
  home: 'DropJect — Go to home',
  languageHref: '/portafolio',
  languageLabel: 'ES',
  quote: 'Get a quote',
  navLabel: 'Main navigation',
  eyebrow: 'Brands that trust us',
  title: ['Ideas brought', 'to life.'],
  intro: 'Every project is a collaboration. These are some of the brands that have worked with DropJect to bring their ideas from the sketchbook to the garment.',
  portfolioLabel: 'Our portfolio',
  portfolioTitle: 'In good company.',
  brands: 'brands',
  unknownBrand: 'Partner brand',
  techniquesLabel: 'From concept to finish',
  techniquesTitle: ['Every idea deserves', 'the right technique.'],
  techniquesText: 'Screen printing, special finishes and end-to-end textile production: we bring our experience to every project.',
  services: 'Explore our services',
  contactLabel: 'Shall we work together?',
  contactTitle: ['Your brand could', 'be next.'],
  contact: 'Tell us about your project',
  socialLabel: 'Social and contact',
  footer: 'Printing at another level.',
  whatsapp: 'WhatsApp',
  instagram: 'Instagram',
} : {
  skip: 'Saltar al contenido',
  home: 'DropJect — Ir al inicio',
  languageHref: '/en/portfolio',
  languageLabel: 'EN',
  quote: 'Cotizar proyecto',
  navLabel: 'Navegación principal',
  eyebrow: 'Marcas que confían en nosotros',
  title: ['Ideas que', 'se hacen realidad.'],
  intro: 'Cada proyecto es una colaboración. Estas son algunas de las marcas que han trabajado con DropJect para llevar sus ideas del papel a la prenda.',
  portfolioLabel: 'Nuestro portafolio',
  portfolioTitle: 'En buena compañía.',
  brands: 'marcas',
  unknownBrand: 'Marca aliada',
  techniquesLabel: 'Del concepto al acabado',
  techniquesTitle: ['Cada idea merece', 'la técnica correcta.'],
  techniquesText: 'Serigrafía, acabados especiales y producción textil integral: ponemos nuestra experiencia al servicio de cada proyecto.',
  services: 'Conoce nuestros servicios',
  contactLabel: '¿Trabajamos juntos?',
  contactTitle: ['Tu marca puede', 'ser la próxima.'],
  contact: 'Cuéntanos tu proyecto',
  socialLabel: 'Redes y contacto',
  footer: 'Estampado a otro nivel.',
  whatsapp: 'WhatsApp',
  instagram: 'Instagram',
};

const clients = [
  { name: 'Ribullvino', logo: '/client-logos/ribullvino.png', width: 1419, height: 474 },
  { name: 'Skeleton Studios', logo: '/client-logos/skeleton-studios.png', width: 1418, height: 268 },
  { name: 'Dislutex S.A.S.', logo: '/client-logos/dislutex.png', width: 945, height: 475 },
  { name: copy.unknownBrand, logo: '/client-logos/monogram.png', width: 299, height: 454 },
  { name: 'MRH', logo: '/client-logos/mrh.png', width: 355, height: 745 },
  { name: 'UTÓPICO', logo: '/client-logos/utopico.png', width: 945, height: 152 },
];
---

<a class="skip-link" href="#main">{copy.skip}</a>

<header class="site-header">
  <a href={isEnglish ? '/en' : '/'} class="brand" aria-label={copy.home}>
    <img src="/logos/05.png" alt="" width="28" height="28" />
    <span>DropJect</span>
  </a>
  <nav class="site-actions" aria-label={copy.navLabel}>
    <a class="language-switch" href={copy.languageHref} lang={isEnglish ? 'es' : 'en'}>{copy.languageLabel}</a>
    <a class="quote-link" href="/contacto">{copy.quote}</a>
  </nav>
</header>

<main id="main">
  <section class="hero" aria-labelledby="page-title">
    <p class="eyebrow"><span aria-hidden="true"></span>{copy.eyebrow}</p>
    <h1 id="page-title">{copy.title[0]}<br /><span>{copy.title[1]}</span></h1>
    <p class="hero-copy">{copy.intro}</p>
  </section>

  <section class="clients" aria-labelledby="clients-title">
    <div class="section-heading">
      <div>
        <p class="section-label">{copy.portfolioLabel}</p>
        <h2 id="clients-title">{copy.portfolioTitle}</h2>
      </div>
      <span class="client-count">{clients.length.toString().padStart(2, '0')} <span>{copy.brands}</span></span>
    </div>

    <ul class="client-grid">
      {clients.map((client) => (
        <li class="client-card">
          <img
            src={client.logo}
            alt={`${isEnglish ? 'Logo of' : 'Logo de'} ${client.name}`}
            width={client.width}
            height={client.height}
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </section>

  <section class="techniques" id="tecnicas" aria-labelledby="techniques-title">
    <p class="section-label">{copy.techniquesLabel}</p>
    <h2 id="techniques-title">{copy.techniquesTitle[0]}<br />{copy.techniquesTitle[1]}</h2>
    <p>{copy.techniquesText}</p>
    <a href="/servicios">{copy.services} <span aria-hidden="true">→</span></a>
  </section>

  <section class="contact-cta" aria-labelledby="cta-title">
    <p class="section-label">{copy.contactLabel}</p>
    <h2 id="cta-title">{copy.contactTitle[0]}<br />{copy.contactTitle[1]}</h2>
    <a href="/contacto">{copy.contact} <span aria-hidden="true">→</span></a>
  </section>
</main>

<footer class="site-footer">
  <div>
    <a href={isEnglish ? '/en' : '/'} class="brand" aria-label={copy.home}>
      <img src="/logos/05.png" alt="" width="18" height="18" />
      <span>DropJect</span>
    </a>
    <p>© {new Date().getFullYear()} DropJect. {copy.footer}</p>
  </div>
  <nav aria-label={copy.socialLabel}>
    <a href="https://wa.me/573117694342" target="_blank" rel="noopener noreferrer">{copy.whatsapp}</a>
    <a href="https://instagram.com/dropject" target="_blank" rel="noopener noreferrer">{copy.instagram}</a>
    <a href="mailto:contacto@dropject.com">contacto@dropject.com</a>
  </nav>
</footer>

<FloatingWhatsApp locale={locale} />

<style is:global>
  :root {
    color-scheme: light;
    --ink: #0d0d0d;
    --paper: #f5f3ef;
    --soft: #e7e4de;
    --muted: #6e6c68;
    --line: rgba(13, 13, 13, .13);
    font-family: Inter, system-ui, sans-serif;
    color: var(--ink);
    background: var(--paper);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; min-width: 320px; background: var(--paper); color: var(--ink); }
  a { color: inherit; }
  .skip-link { position: absolute; left: -9999px; top: 1rem; z-index: 20; background: var(--ink); color: var(--paper); padding: .75rem 1rem; }
  .skip-link:focus { left: 1rem; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 5.6rem;
    padding: 1.25rem max(2rem, calc((100vw - 1120px) / 2));
    border-bottom: 1px solid var(--line);
    background: rgba(245, 243, 239, .92);
    backdrop-filter: blur(12px);
  }
  .brand { display: inline-flex; align-items: center; gap: .55rem; text-decoration: none; text-transform: uppercase; font-size: .8rem; font-weight: 700; letter-spacing: .18em; }
  .brand img { display: block; object-fit: contain; }
  .site-actions { display: flex; align-items: center; gap: .65rem; }
  .site-actions a { padding: .75rem 1rem; text-decoration: none; text-transform: uppercase; font-size: .66rem; font-weight: 600; letter-spacing: .13em; }
  .language-switch { border: 1px solid var(--line); }
  .quote-link { background: var(--ink); color: var(--paper); }
  .site-actions a:hover, .contact-cta a:hover { background: var(--soft); color: var(--ink); }

  .hero, .clients, .techniques, .contact-cta { max-width: 1120px; margin-inline: auto; padding-inline: 2rem; }
  .hero { display: flex; min-height: 29rem; flex-direction: column; justify-content: center; padding-top: 5rem; padding-bottom: 5rem; }
  .eyebrow, .section-label { margin: 0 0 1.1rem; color: var(--muted); font-size: .66rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
  .eyebrow { display: flex; align-items: center; gap: .65rem; }
  .eyebrow span { width: .5rem; height: .5rem; border-radius: 50%; background: var(--ink); }
  h1, h2, p { margin-top: 0; }
  .hero h1 { margin-bottom: 1.5rem; font-size: clamp(3.2rem, 8vw, 7.5rem); font-weight: 700; letter-spacing: -.06em; line-height: .9; text-transform: uppercase; }
  .hero h1 span { color: var(--muted); }
  .hero-copy { max-width: 36rem; margin-bottom: 0; color: var(--muted); font-size: 1rem; line-height: 1.75; }

  .clients { padding-top: 2.5rem; padding-bottom: 7rem; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .section-heading h2, .techniques h2, .contact-cta h2 { margin-bottom: 0; font-size: clamp(2rem, 4vw, 3.4rem); font-weight: 600; letter-spacing: -.045em; line-height: 1; text-transform: uppercase; }
  .section-heading .section-label { margin-bottom: .8rem; }
  .client-count { color: var(--muted); font-size: .7rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; white-space: nowrap; }
  .client-count span { font-weight: 400; }
  .client-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 1px; list-style: none; background: var(--line); border: 1px solid var(--line); }
  .client-card { display: flex; min-height: 14rem; align-items: center; justify-content: center; padding: 2.5rem; background: var(--paper); transition: background .25s; }
  .client-card:hover { background: #fff; }
  .client-card img { display: block; width: auto; max-width: min(100%, 18rem); height: auto; max-height: 8rem; object-fit: contain; }

  .techniques { padding-top: 4.5rem; padding-bottom: 4.5rem; border-top: 1px solid var(--line); }
  .techniques h2, .contact-cta h2 { margin-bottom: 1.25rem; }
  .techniques > p:not(.section-label) { max-width: 34rem; margin-bottom: 1.5rem; color: var(--muted); font-size: .9rem; line-height: 1.7; }
  .techniques a, .contact-cta a { display: inline-flex; align-items: center; gap: .75rem; padding: .9rem 1.1rem; background: var(--ink); color: var(--paper); text-decoration: none; text-transform: uppercase; font-size: .68rem; font-weight: 600; letter-spacing: .1em; transition: background .2s, color .2s; }
  .contact-cta { max-width: none; padding-block: 5rem; background: var(--soft); text-align: center; }
  .contact-cta .section-label { margin-bottom: 1rem; }
  .contact-cta h2 { margin-bottom: 1.75rem; }

  .site-footer { display: flex; max-width: 1120px; align-items: center; justify-content: space-between; gap: 2rem; margin-inline: auto; padding: 2.4rem 2rem; }
  .site-footer p { margin: .6rem 0 0; color: var(--muted); font-size: .68rem; }
  .site-footer nav { display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .site-footer nav a { color: var(--muted); font-size: .66rem; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
  .site-footer nav a:hover { color: var(--ink); }

  @media (max-width: 760px) {
    .site-header { min-height: 4.8rem; padding: 1rem 1.3rem; }
    .site-actions { gap: .4rem; }
    .site-actions a { padding: .65rem .75rem; font-size: .6rem; }
    .hero, .clients, .techniques, .site-footer { padding-inline: 1.3rem; }
    .hero { min-height: 24rem; padding-top: 4rem; padding-bottom: 3rem; }
    .hero h1 { font-size: clamp(3rem, 14vw, 5.5rem); }
    .clients { padding-top: 1rem; padding-bottom: 4rem; }
    .client-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .client-card { min-height: 10rem; padding: 1.4rem; }
    .client-card img { max-width: 100%; max-height: 6rem; }
    .contact-cta { padding: 4rem 1.3rem; }
    .site-footer { align-items: flex-start; flex-direction: column; }
  }

  @media (max-width: 420px) {
    .brand { font-size: .7rem; }
    .brand img { width: 24px; height: 24px; }
    .site-actions a { padding-inline: .55rem; font-size: .56rem; }
    .section-heading { align-items: start; }
    .client-card { min-height: 8.5rem; padding: 1rem; }
    .client-card img { max-height: 4.8rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
  }
</style>
